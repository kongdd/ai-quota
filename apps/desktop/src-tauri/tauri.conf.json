{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Quota",
  "version": "0.1.0",
  "identifier": "io.github.kongdd.aiquota.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Quota",
        "width": 450,
        "height": 400,
        "minWidth": 380,
        "minHeight": 360,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
